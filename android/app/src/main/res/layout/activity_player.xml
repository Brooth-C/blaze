<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?android:attr/colorBackground">
    <LinearLayout android:id="@+id/player_header" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="24dp"
        android:paddingTop="12dp" android:paddingBottom="12dp" android:gravity="center_vertical">
        <Button android:id="@+id/player_back" android:layout_width="48dp" android:layout_height="48dp"
            android:minHeight="48dp" android:minWidth="0dp" android:text="Back" android:textAllCaps="false" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:paddingStart="16dp">
            <TextView android:id="@+id/player_caption" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="NOW PLAYING" android:textSize="10sp" android:letterSpacing="0.12" android:paddingBottom="4dp" />
            <TextView android:id="@+id/player_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Blaze player" android:textSize="18sp" android:fontFamily="sans-serif-medium"
                android:maxLines="2" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <androidx.media3.ui.PlayerView android:id="@+id/media_player"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:keepScreenOn="false" android:background="#000000"
        app:resize_mode="fit" app:show_buffering="when_playing"
        app:show_previous_button="false" app:show_next_button="false"
        app:show_subtitle_button="true" app:show_timeout="3000" />
    <TextView android:id="@+id/player_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="20dp" android:paddingBottom="24dp"
        android:text="Opening your download…" android:textSize="13sp" />
    <Button android:id="@+id/player_retry" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="24dp" android:layout_marginEnd="24dp" android:layout_marginBottom="24dp"
        android:minHeight="52dp" android:text="Try again" android:textAllCaps="false" android:visibility="gone" />
</LinearLayout>
